# =====================================================================
# VAYU-DRISHTI / Cyclone Intelligence Platform - Environment Config
# =====================================================================

# ISRO MOSDAC (Space Applications Centre) API Credentials
# When you receive your approval email from MOSDAC (https://www.mosdac.gov.in/),
# copy this file to .env and insert your approved API key and user email below.
MOSDAC_API_KEY=
MOSDAC_USER_EMAIL=
MOSDAC_API_URL=https://www.mosdac.gov.in/api/v1

# NOAA / JTWC Active Tropical Cyclones Feed URL
ARCGIS_LIVE_HURRICANES_URL=https://services9.arcgis.com/RHVPKKiFTONKtxq3/arcgis/rest/services/Active_Hurricanes_v1/FeatureServer/0/query?where=1%3D1&outFields=*&f=geojson

# Operational Server Settings
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development
